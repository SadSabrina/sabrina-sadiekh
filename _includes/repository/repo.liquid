{% assign parts = include.repository | split: "/" %}
{% assign repo_name = parts[1] %}
<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}" rel="external nofollow noopener" target="_blank">
    <img
      class="w-100"
      alt="{{ repo_name }}"
      src="https://opengraph.githubassets.com/1/{{ include.repository }}"
      style="border-radius: 8px; max-width: 420px;"
    >
  </a>
</div>
